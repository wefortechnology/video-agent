# Copy to .env and fill in. Never commit .env, never paste keys into chat or prompts.

# Gemini: ideas + scripts (+ optional TTS). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Free stock footage keys (free forever, instant signup)
# Pexels:  https://www.pexels.com/api/
# Pixabay: https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Voice: kokoro (local, free, default) or gemini
VOICE_ENGINE=kokoro
KOKORO_MODELS_DIR=~/.video-studio/models
